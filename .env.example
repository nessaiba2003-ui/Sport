NODE_ENV=production
PORT=3100
APP_SESSION_SECRET=replace-with-at-least-64-random-characters
PUBLIC_BASE_URL=https://votre-domaine.ma

# Gmail / SMTP (utiliser un mot de passe d'application Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot-de-passe-application
SMTP_FROM=Association El Jawarih <votre-adresse@gmail.com>

# PostgreSQL / Prisma pour la production durable
DATABASE_URL=postgresql://user:password@host:5432/aljawarih

# Compte administrateur créé lors de l'initialisation de la base
DEMO_ADMIN_EMAIL=admin@votre-domaine.ma
DEMO_ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-fort
